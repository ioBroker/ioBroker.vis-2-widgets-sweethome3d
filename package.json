{
  "name": "iobroker.vis-2-widgets-sweethome3d",
  "version": "0.2.0",
  "description": "ioBroker vis2 material widgets",
  "author": "bluefox <dogafox@gmail.com>",
  "contributors": [
    "bluefox <dogafox@gmail.com>"
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.vis-2-widgets-sweethome3d",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.vis-2-widgets-sweethome3d"
  },
  "keywords": [
    "ioBroker",
    "3D",
    "SweetHome3D"
  ],
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/vis-2-widgets-testing": "^2.0.0",
    "@types/decompress": "^4.2.7",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.20.5",
    "decompress": "^4.2.1",
    "mocha": "^10.7.3",
    "tsx": "^4.21.1",
    "typescript": "~7.0.2"
  },
  "main": "main.js",
  "files": [
    "admin/",
    "img/",
    "io-package.json",
    "LICENSE",
    "widgets/",
    "licenses/"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "lint": "eslint -c eslint.config.mjs",
    "check": "tsc && cd src-widgets && tsc",
    "build": "tsx tasks.ts",
    "update-viewer-source": "tsx tasks.ts --update-viewer-source",
    "widget-0-clean": "tsx tasks.ts --widget-0-clean",
    "widget-1-npm": "tsx tasks.ts --widget-1-npm",
    "widget-2-compile": "tsx tasks.ts --widget-2-compile",
    "widget-3-copy": "tsx tasks.ts --widget-3-copy",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "test": "mocha ./test/*.test.js",
    "test:package": "mocha test/package.js --exit",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-widgets && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-widgets && npm i"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.vis-2-widgets-sweethome3d/issues"
  },
  "readmeFilename": "README.md",
  "engines": {
    "node": ">=22"
  }
}
